# Optional fixed API URL. Leave empty to resolve the API from the current
# platform/school hostname. Example local platform API:
# http://admin.localhost:8000/api/v1
VITE_API_URL=

# Local development only. Production builds automatically use secure cookie auth
# regardless of this value. Do not place secrets in VITE_* variables because
# Vite exposes VITE_* values to browser JavaScript.
VITE_AUTH_COOKIE_MODE=false
