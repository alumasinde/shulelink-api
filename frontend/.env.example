# Copy to frontend/.env.local for development.
# Vite exposes VITE_* values to browser JavaScript; never put secrets here.

# The API is resolved from the current ShuleLink hostname so tenant routing
# remains aligned with the browser hostname.
VITE_API_PATH=/api/v1
VITE_API_PORT=8000
VITE_PLATFORM_HOST=admin.localhost
VITE_ROOT_DOMAIN=localhost
VITE_DEVELOPMENT_DOMAIN=localhost
VITE_DEVELOPMENT_HOSTS=admin.localhost,localhost,127.0.0.1

# Explicit development authentication mode. Production builds force cookie mode.
VITE_AUTH_COOKIE_MODE=false
