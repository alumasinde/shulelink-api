# Staging build-time configuration. Never place secrets in VITE_* values.
VITE_API_PATH=/api/v1
VITE_API_PORT=
VITE_PLATFORM_HOST=admin.staging.shulelink.co.ke
VITE_ROOT_DOMAIN=staging.shulelink.co.ke
VITE_DEVELOPMENT_DOMAIN=localhost
VITE_DEVELOPMENT_HOSTS=admin.localhost,localhost,127.0.0.1
VITE_AUTH_COOKIE_MODE=true
