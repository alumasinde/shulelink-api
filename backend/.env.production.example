# Production template only. Inject every value from your deployment secret/config store.
# Never copy real production credentials into this repository.
APP_NAME=ShuleLink
APP_ENV=production
DEBUG=false
APP_VERSION=0.2.0
API_V1_PREFIX=/api/v1

DB_HOST=production-db.internal
DB_PORT=3306
DB_NAME=shulelink
DB_USER=shulelink_app
DB_PASSWORD=INJECT_SECRET_AT_DEPLOYMENT
DB_SSL_CA=/run/secrets/production-db-ca.pem
DB_SSL_VERIFY=true
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_TENANT_POOL_MIN_SIZE=1
DB_TENANT_POOL_MAX_SIZE=4
DB_MAX_DEDICATED_TENANT_POOLS=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
DB_READ_TIMEOUT_SECONDS=30
DB_WRITE_TIMEOUT_SECONDS=30

CORS_ORIGINS=https://admin.shulelink.co.ke
CORS_ORIGIN_REGEX=^https://([a-z0-9-]+\\.)?shulelink\\.co\\.ke$
TRUSTED_HOSTS=admin.shulelink.co.ke,*.shulelink.co.ke
MAX_REQUEST_BODY_BYTES=10485760
LOG_LEVEL=INFO
RATE_LIMIT_STORAGE_URI=redis://production-redis.internal:6379/0
RATE_LIMIT_DEFAULT=120/minute

JWT_SECRET_KEY=INJECT_SECRET_AT_DEPLOYMENT
JWT_ALGORITHM=HS256
JWT_ISSUER=shulelink-api
JWT_AUDIENCE=shulelink
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
PASSWORD_MIN_LENGTH=10

AUTH_COOKIE_MODE=true
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
CSRF_TOKEN_BYTES=32
AUTH_RESET_RETURN_TOKEN=false
PASSWORD_RESET_MINUTES=30
MFA_CHALLENGE_MINUTES=5
MFA_ISSUER=ShuleLink
CREDENTIAL_ENCRYPTION_KEY=INJECT_SECRET_AT_DEPLOYMENT

SMTP_HOST=production-smtp.internal
SMTP_PORT=587
SMTP_USERNAME=INJECT_SECRET_AT_DEPLOYMENT
SMTP_PASSWORD=INJECT_SECRET_AT_DEPLOYMENT
SMTP_FROM=no-reply@shulelink.co.ke
SMTP_STARTTLS=true
PASSWORD_RESET_BASE_URL=https://admin.shulelink.co.ke/reset-password

DB_PROVISIONER_HOST=production-db-provisioner.internal
DB_PROVISIONER_PORT=3306
DB_PROVISIONER_USER=shulelink_provisioner
DB_PROVISIONER_PASSWORD=INJECT_SECRET_AT_DEPLOYMENT
DB_PROVISIONER_TENANT_HOST=%

PLATFORM_ADMIN_HOST=admin.shulelink.co.ke
ROOT_DOMAIN=shulelink.co.ke
