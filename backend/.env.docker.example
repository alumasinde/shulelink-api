APP_NAME=ShuleLink
APP_ENV=development
DEBUG=true
APP_VERSION=0.2.0
API_V1_PREFIX=/api/v1
DB_HOST=mysql
DB_PORT=3306
DB_NAME=shulelink
DB_USER=shulelink_app
DB_PASSWORD=CHANGE_ME
DB_SSL_VERIFY=false
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_TENANT_POOL_MIN_SIZE=1
DB_TENANT_POOL_MAX_SIZE=4
DB_MAX_DEDICATED_TENANT_POOLS=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
DB_READ_TIMEOUT_SECONDS=30
DB_WRITE_TIMEOUT_SECONDS=30
CORS_ORIGINS=http://localhost:5173,http://admin.localhost:5173
CORS_ORIGIN_REGEX=^https?://([a-z0-9-]+\\.)?localhost:5173$
TRUSTED_HOSTS=localhost,127.0.0.1,admin.localhost,*.localhost,testserver
MAX_REQUEST_BODY_BYTES=10485760
LOG_LEVEL=INFO
RATE_LIMIT_STORAGE_URI=redis://redis:6379/0
RATE_LIMIT_DEFAULT=120/minute
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
JWT_ISSUER=shulelink-api
JWT_AUDIENCE=shulelink
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
PASSWORD_MIN_LENGTH=10
AUTH_COOKIE_MODE=false
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
CSRF_TOKEN_BYTES=32
AUTH_RESET_RETURN_TOKEN=true
PASSWORD_RESET_MINUTES=30
MFA_CHALLENGE_MINUTES=5
MFA_ISSUER=ShuleLink
CREDENTIAL_ENCRYPTION_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
PASSWORD_RESET_BASE_URL=http://localhost:5173/reset-password
DB_PROVISIONER_HOST=
DB_PROVISIONER_PORT=3306
DB_PROVISIONER_USER=
DB_PROVISIONER_PASSWORD=
DB_PROVISIONER_TENANT_HOST=mysql
PLATFORM_ADMIN_HOST=admin.localhost
ROOT_DOMAIN=localhost
