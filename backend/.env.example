APP_NAME=ShuleLink
APP_ENV=development
DEBUG=true
APP_VERSION=0.2.0
API_V1_PREFIX=/api/v1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=shulelink
DB_USER=shulelink_app
DB_PASSWORD=
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
DB_READ_TIMEOUT_SECONDS=30
DB_WRITE_TIMEOUT_SECONDS=30

CORS_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1,*.localhost
MAX_REQUEST_BODY_BYTES=10485760
LOG_LEVEL=INFO

# Development can use memory://. Production must use a shared store, e.g. Redis.
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_DEFAULT=120/minute

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=shulelink-api
JWT_AUDIENCE=shulelink
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
PASSWORD_MIN_LENGTH=10
PLATFORM_ADMIN_HOST=admin.shulelink.co.ke
ROOT_DOMAIN=shulelink.co.ke
