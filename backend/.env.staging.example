# Staging must be isolated from production data and credentials.
# Inject real values at deployment time; do not commit this as .env.staging.
APP_NAME=ShuleLink
APP_ENV=staging
DEBUG=false
APP_VERSION=0.2.0
API_V1_PREFIX=/api/v1

DB_HOST=staging-db.internal
DB_PORT=3306
DB_NAME=shulelink_staging
DB_USER=shulelink_staging_app
DB_PASSWORD=CHANGE_ME
DB_SSL_CA=/run/secrets/staging-db-ca.pem
DB_SSL_VERIFY=true
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
DB_READ_TIMEOUT_SECONDS=30
DB_WRITE_TIMEOUT_SECONDS=30

CORS_ORIGINS=https://staging.shulelink.co.ke
CORS_ORIGIN_REGEX=^https://([a-z0-9-]+\\.)?staging\\.shulelink\\.co\\.ke$
TRUSTED_HOSTS=staging.shulelink.co.ke,*.staging.shulelink.co.ke
MAX_REQUEST_BODY_BYTES=10485760
LOG_LEVEL=INFO
RATE_LIMIT_STORAGE_URI=redis://staging-redis.internal:6379/0
RATE_LIMIT_DEFAULT=120/minute

JWT_SECRET_KEY=INJECT_SECRET_AT_DEPLOYMENT
JWT_ALGORITHM=HS256
JWT_ISSUER=shulelink-api-staging
JWT_AUDIENCE=shulelink-staging
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
PASSWORD_MIN_LENGTH=10

AUTH_COOKIE_MODE=true
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
CSRF_TOKEN_BYTES=32
AUTH_RESET_RETURN_TOKEN=false
PASSWORD_RESET_MINUTES=30
MFA_CHALLENGE_MINUTES=5
MFA_ISSUER=ShuleLink Staging
CREDENTIAL_ENCRYPTION_KEY=INJECT_SECRET_AT_DEPLOYMENT

SMTP_HOST=staging-smtp.internal
SMTP_PORT=587
SMTP_USERNAME=INJECT_SECRET_AT_DEPLOYMENT
SMTP_PASSWORD=INJECT_SECRET_AT_DEPLOYMENT
SMTP_FROM=no-reply@staging.shulelink.co.ke
SMTP_STARTTLS=true
PASSWORD_RESET_BASE_URL=https://staging.shulelink.co.ke/reset-password

DB_PROVISIONER_HOST=staging-db-provisioner.internal
DB_PROVISIONER_PORT=3306
DB_PROVISIONER_USER=shulelink_provisioner
DB_PROVISIONER_PASSWORD=INJECT_SECRET_AT_DEPLOYMENT
DB_PROVISIONER_TENANT_HOST=%

PLATFORM_ADMIN_HOST=admin.staging.shulelink.co.ke
ROOT_DOMAIN=staging.shulelink.co.ke
