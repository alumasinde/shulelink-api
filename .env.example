# ShuleLink Phase 1 environment
APP_NAME=ShuleLink
APP_ENV=development
DEBUG=true
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=shulelink
DB_USER=root
DB_PASSWORD=
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# Security / HTTP
CORS_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1
MAX_REQUEST_BODY_BYTES=10485760

# Phase 1 operational settings
LOG_LEVEL=INFO
